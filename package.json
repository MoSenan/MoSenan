{
  "name": "promptforge-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "PromptForge Studio - professional AI prompt engineering desktop app",
  "author": "PromptForge",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fonts.mjs && tsc --noEmit && vite build",
    "test": "node --test tests/engine.test.ts",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "shots": "electron electron/shot.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "studio.promptforge.app",
    "productName": "PromptForge Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/main.cjs",
      "electron/preload.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "optionalDependencies": {
    "@fontsource/cairo": ">=5.0.0",
    "@fontsource/tajawal": ">=5.0.0",
    "@fontsource/almarai": ">=5.0.0",
    "@fontsource/readex-pro": ">=5.0.0",
    "@fontsource/ibm-plex-sans-arabic": ">=5.0.0",
    "@fontsource/alexandria": ">=5.0.0",
    "@fontsource/noto-kufi-arabic": ">=5.0.0",
    "@fontsource/reem-kufi": ">=5.0.0",
    "@fontsource/amiri": ">=5.0.0",
    "@fontsource/noto-naskh-arabic": ">=5.0.0",
    "@fontsource/scheherazade-new": ">=5.0.0",
    "@fontsource/lateef": ">=5.0.0",
    "@fontsource/markazi-text": ">=5.0.0",
    "@fontsource/harmattan": ">=5.0.0",
    "@fontsource/changa": ">=5.0.0",
    "@fontsource/lalezar": ">=5.0.0",
    "@fontsource/rakkas": ">=5.0.0",
    "@fontsource/baloo-bhaijaan-2": ">=5.0.0",
    "@fontsource/marhey": ">=5.0.0",
    "@fontsource/el-messiri": ">=5.0.0",
    "@fontsource/jomhuria": ">=5.0.0",
    "@fontsource/aref-ruqaa": ">=5.0.0",
    "@fontsource/katibeh": ">=5.0.0",
    "@fontsource/mirza": ">=5.0.0",
    "@fontsource/vibes": ">=5.0.0",
    "@fontsource/inter": ">=5.0.0",
    "@fontsource/poppins": ">=5.0.0",
    "@fontsource/montserrat": ">=5.0.0",
    "@fontsource/space-grotesk": ">=5.0.0",
    "@fontsource/syne": ">=5.0.0",
    "@fontsource/playfair-display": ">=5.0.0",
    "@fontsource/dm-serif-display": ">=5.0.0",
    "@fontsource/abril-fatface": ">=5.0.0",
    "@fontsource/anton": ">=5.0.0",
    "@fontsource/bebas-neue": ">=5.0.0",
    "@fontsource/oswald": ">=5.0.0",
    "@fontsource/righteous": ">=5.0.0",
    "@fontsource/lobster": ">=5.0.0",
    "@fontsource/pacifico": ">=5.0.0",
    "@fontsource/dancing-script": ">=5.0.0",
    "@fontsource/great-vibes": ">=5.0.0",
    "@fontsource/caveat": ">=5.0.0",
    "@fontsource/permanent-marker": ">=5.0.0"
  }
}