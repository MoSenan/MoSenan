{
  "name": "promptforge-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "PromptForge Studio - professional AI prompt engineering desktop app",
  "author": "PromptForge",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/engine.test.ts",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "shots": "electron electron/shot.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/cairo": "^5.1.0",
    "@fontsource/tajawal": "^5.1.0",
    "@fontsource/amiri": "^5.1.0",
    "@fontsource/reem-kufi": "^5.1.0",
    "@fontsource/montserrat": "^5.1.0",
    "@fontsource/playfair-display": "^5.1.0",
    "@fontsource/bebas-neue": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "studio.promptforge.app",
    "productName": "PromptForge Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/main.cjs",
      "electron/preload.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}